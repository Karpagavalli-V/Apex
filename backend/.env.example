# Banking Application Environment Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-secure-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
DB_NAME=banking_dev
TEST_DB_NAME=banking_test

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Generative AI & LLM Integration (Phase 4)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=30
AI_FALLBACK_ON_ERROR=true
